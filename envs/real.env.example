# Реальная среда. Zigbee2MQTT работает со стиком, отдельная база valo-real, моков нет
VALO_ENV=real
VALO_DEMO=false
COMPOSE_PROFILES=zigbee
POSTGRES_PASSWORD=__secret__
RABBITMQ_PASSWORD=__secret__
JWT_SECRET=__secret__
# Ключ шифрования секретов расширений. Пусто значит, что ключ выводится из JWT_SECRET (при смене JWT_SECRET секреты придется ввести заново)
VALO_SECRET_KEY=
MQTT_USER=valo-core
MQTT_PASSWORD=__secret__
Z2M_MQTT_PASSWORD=__secret__
MOCKS_MQTT_PASSWORD=
Z2M_BASE_TOPIC=zigbee2mqtt
WEB_BIND=0.0.0.0
WEB_PORT=3100
# Брокер открыт в локальную сеть для MQTT устройств и удаленных расширений
MQTT_BIND=0.0.0.0
MQTT_PORT=1883
# Адреса внешнего прокси с TLS (инфраструктура сервера) через пробел. По умолчанию сети Docker и localhost
EDGE_TRUSTED_PROXIES=172.16.0.0/12 127.0.0.1/32
WS_PUBLIC_URL=
WS_CORS=*
VALO_PEERS=demo=http://localhost:3000
# Координатор. Путь лучше брать из /dev/serial/by-id, он не меняется при переподключении
ZIGBEE_ADAPTER=/dev/ttyUSB0
# ember для Silicon Labs EFR32 (Sonoff Dongle-E, ZBT-1, SkyConnect), zstack для TI CC2652 (Sonoff Dongle-P)
ZIGBEE_ADAPTER_TYPE=ember
ZIGBEE_BAUDRATE=115200
ZIGBEE_RTSCTS=false
# Параметры сети используются только при первом старте, дальше Z2M хранит их в своем томе
# GENERATE создает новую сеть. Чтобы подхватить сеть, уже записанную в стике, укажите ее значения
ZIGBEE_CHANNEL=15
ZIGBEE_PAN_ID=GENERATE
ZIGBEE_EXT_PAN_ID=GENERATE
ZIGBEE_NETWORK_KEY=GENERATE
SESSION_TTL=2592000
COMMAND_TIMEOUT=5
BACKUP_KEEP=7
# Лимиты одного процесса расширения по умолчанию (манифест может задать меньше в runtime.memory и runtime.cpu)
EXT_MEM_LIMIT=256
EXT_CPU_LIMIT=80
# Лимиты всего контейнера расширений
EXT_CONTAINER_MEM=1g
EXT_CONTAINER_CPUS=1.5
# Второе место для резервных копий. По умолчанию ./backups/<среда> в папке проекта, она на другом диске, чем тома Docker
BACKUP_MIRROR_HOST=
# Корень хранилища записей камер на хосте. Папку внутри него выбирают в интерфейсе (Камеры, Хранилище). По умолчанию ./media/<среда> в папке проекта
MEDIA_ROOT=
# Временный буфер последних секунд видео в памяти, на все камеры
CAMERAS_BUFFER_SIZE=512m
UPDATE_URL=
LOG_LEVEL=info
LOG_JSON=true
TZ=Europe/Helsinki
