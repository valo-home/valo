  "settings": [
    {
      "key": "period",
      "type": "number",
      "default": 20
    }
  ],
  "blocks": [
    {
      "key": "simulate",
      "kind": "act",
      "icon": "terminal",
      "name": {
        "uk": "Імітувати подію",
        "en": "Simulate event",
        "ru": "Сымитировать событие",
        "ja": "イベントを模擬",
        "fr": "Simuler un événement",
        "de": "Ereignis simulieren",
        "es": "Simular evento"
      },
      "params": [
        {
          "key": "occ",
          "type": "bool",
          "default": true
        }
      ]
    }
  ],
  "camera": {
    "fields": [
      {
        "key": "pattern",
        "type": "select",
        "default": "yard",
        "options": [
          "yard",
          "door"
        ],
        "name": {
          "uk": "Тестова картинка",
          "en": "Test picture",
          "ru": "Тестовая картинка",
          "ja": "テスト映像",
          "fr": "Image de test",
          "de": "Testbild",
          "es": "Imagen de prueba"
        }
      }
    ],
    "features": [
      "settings",
      "actions",
      "diagnose",
      "discover",
      "ptz"
    ]
  }
